# The exact public origin, including scheme and port. Use HTTPS behind your reverse proxy.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
S3_PORT=9000
# Generate independent random values. Never commit your real .env.
SETUP_TOKEN=replace-with-at-least-24-random-characters
BACKUP_PASSPHRASE=replace-with-a-separate-long-recovery-passphrase
# Unraid's nobody:users identity. Pre-create these directories with matching ownership.
PUID=99
PGID=100
DATA_PATH=./data
# Pre-create for a local trial, or use the real mount path for an NFS/SMB destination.
NETWORK_BACKUP_PATH=./network-backups
BACKUP_INTERVAL_SECONDS=86400
SCHEDULE_DESTINATION=local
