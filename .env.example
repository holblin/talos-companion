# The exact public origin, including scheme and port. Use HTTPS behind your reverse proxy.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
S3_PORT=9000
# Optional overrides. Blank values generate private persistent secrets on a fresh installation.
# Get the setup token from container logs; save the backup passphrase from the wizard.
# Never commit your real .env or generated secret files.
SETUP_TOKEN=
BACKUP_PASSPHRASE=
# Unraid's nobody:users identity. Pre-create these directories with matching ownership.
PUID=99
PGID=100
DATA_PATH=./data
# Configure remote NFS/SMB directly in Backups after sign-in.
# Configure retention and scheduled backups in the administrator Settings page.
