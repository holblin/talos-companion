{
  "name": "talos-companion-web",
  "version": "0.3.13",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && vite build",
    "lint": "eslint src tests vite.config.ts vitest.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write src tests scripts vite.config.ts vitest.config.ts eslint.config.mjs tsconfig.json",
    "format:check": "prettier --check src tests scripts vite.config.ts vitest.config.ts eslint.config.mjs tsconfig.json",
    "postinstall": "node scripts/patch-dependency-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "@react-spectrum/s2": "1.8.2",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@react-aria/test-utils": "1.0.0-rc.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-parcel-macros": "0.2.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
